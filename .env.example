# OpenAI-compatible model endpoint
BASE_URL=https://api.example.com/v1
API_KEY=your-api-key
MODEL=openai/your-model-id

# Optional LLM tuning
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=300

# Google Cloud Storage (used by PythonCodeRunTool)
GCP_PROJECT_ID=your-gcp-project-id
GCP_BUCKET_NAME=your-bucket-name
GCP_SERVICE_KEY=base64-encoded-service-account-json

# Optional public origin for generated preview links
# AI_AGENTIC_CODER_BASE_URL=https://your-public-domain.example.com
